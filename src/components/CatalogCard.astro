---
import { getDictionary } from "../i18n";

interface Props {
  id: number;
  title: string;
  coverImage?: string | null;
  color?: string | null;
  year?: number | null;
  format?: string | null;
  averageScore?: number | null;
  status?: "CURRENT" | "PLANNING" | "COMPLETED" | null;
}

const {
  id,
  title,
  coverImage,
  color,
  year,
  format,
  averageScore,
  status = null,
} = Astro.props;

const dict = getDictionary(Astro.locals.locale);
const formatLabels = dict.formats as Record<string, string>;
const formatLabel = format ? formatLabels[format] ?? format : null;
const meta = [year ? String(year) : null, formatLabel].filter(Boolean).join(" • ");
const scoreLabel =
  typeof averageScore === "number" && averageScore > 0 ? (averageScore / 10).toFixed(1) : null;

const STATUS_META = {
  CURRENT: { label: dict.status.current, tone: "text-cyan border-cyan/30" },
  PLANNING: { label: dict.status.planning, tone: "text-violet border-violet/30" },
  COMPLETED: { label: dict.status.completed, tone: "text-emerald border-emerald/30" },
} as const;

const statusMeta = status ? STATUS_META[status] : null;
---

<a href={`/anime/${id}`} class="group flex flex-col">
  <div
    class="relative aspect-[2/3] w-full overflow-hidden rounded-xl border border-white/5 shadow-lg shadow-black/30 transition-all duration-300 group-hover:scale-[1.03] group-hover:border-violet"
    style={`background-color: ${color || "#1E293B"}`}
  >
    {coverImage && (
      <img
        src={coverImage}
        alt={title}
        loading="lazy"
        decoding="async"
        width={300}
        height={450}
        class="h-full w-full object-cover object-center"
      />
    )}

    {statusMeta && (
      <span
        class:list={[
          "absolute right-2 top-2 inline-flex items-center rounded-full border bg-obsidian/60 px-2 py-0.5 text-[10px] font-semibold shadow-md backdrop-blur-md",
          statusMeta.tone,
        ]}
      >
        {statusMeta.label}
      </span>
    )}
  </div>

  <h3
    class="mt-2 line-clamp-2 text-xs font-semibold leading-snug text-text transition-colors group-hover:text-violet"
    title={title}
  >
    {title}
  </h3>

  <div class="mt-0.5 flex items-center justify-between gap-2 text-[11px]">
    <span class="truncate text-text-muted">{meta}</span>
    {scoreLabel && <span class="shrink-0 font-semibold text-emerald">{scoreLabel}</span>}
  </div>
</a>
