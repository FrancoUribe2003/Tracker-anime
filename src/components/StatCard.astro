---
interface Props {
  isTitleCard?: boolean;
  title?: string;
  value?: string | number;
  label: string;
  progress?: number;
  tag?: string;
}

const {
  isTitleCard = false,
  title = "Archivo Maestro",
  value = 0,
  label,
  progress = 0,
  tag = "Completados",
} = Astro.props;

const clampedProgress = Math.min(Math.max(progress, 0), 100);
---

<div class="bg-surface border border-white/5 rounded-2xl p-4 sm:p-5 flex flex-col justify-between shadow-lg shadow-black/20 hover:border-white/10 transition-colors">
  {isTitleCard ? (
    <div class="flex flex-col justify-between h-full space-y-4">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-violet px-2.5 py-1 rounded-full bg-violet/10 border border-violet/20">
          {tag}
        </span>
        <div class="w-2 h-2 rounded-full bg-emerald"></div>
      </div>
      <div>
        <h2 class="text-lg sm:text-xl font-bold tracking-tight text-text">
          {title}
        </h2>
        <p class="text-xs text-text-muted mt-1 font-medium">{label}</p>
      </div>
      <div class="h-1.5 w-full bg-surface-2 rounded-full overflow-hidden">
        <div class="h-full bg-gradient-to-r from-violet to-cyan rounded-full w-full"></div>
      </div>
    </div>
  ) : (
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs text-text-muted font-medium">{label}</span>
      </div>
      <div class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-text">
        {value}
      </div>
      <div class="space-y-1">
        <div class="h-1.5 w-full bg-surface-2 rounded-full overflow-hidden">
          <div
            class="h-full bg-gradient-to-r from-violet to-cyan rounded-full transition-all duration-500"
            style={`width: ${clampedProgress}%`}
          ></div>
        </div>
      </div>
    </div>
  )}
</div>
