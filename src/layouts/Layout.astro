---
import Analytics from "@vercel/analytics/astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import { SITE_NAME } from "../lib/site";
import { getDictionary } from "../i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  activeNav?: "inicio" | "catalogo" | "hoy" | "top";
  counts?: {
    completed?: number;
    current?: number;
    planning?: number;
    top?: number;
  };
}

const { title, activeNav, counts } = Astro.props;
const locale = Astro.locals.locale;
const dict = getDictionary(locale);
const pageTitle = title ? `${title} - ${SITE_NAME}` : SITE_NAME;
const user = Astro.locals.user;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <meta name="google-site-verification" content="sK5oWvn_PHADxhf5U07wn6OQ_YvCaLrW8phpz9dXk-A" />
    <meta name="description" content={dict.meta.description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-dvh flex-col bg-obsidian font-sans text-text antialiased selection:bg-violet selection:text-white">
    <Navbar client:idle user={user} currentPath={currentPath} activeNav={activeNav} counts={counts} locale={locale} dict={dict.nav} statusDict={dict.status} />

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
      <slot />
    </main>

    <Footer />

    <Analytics />

    <script is:inline>
      // Al volver con el botón "atrás", el navegador puede restaurar la página
      // desde el bfcache con datos previos a una mutación. Forzamos recarga.
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) {
          window.location.reload();
        }
      });
    </script>
  </body>
</html>
