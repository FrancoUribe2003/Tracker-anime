---
import Layout from "../layouts/Layout.astro";
import CatalogCard from "../components/CatalogCard.astro";
import { z } from "zod";
import { getCatalogPage } from "../lib/anilist";
import type { CatalogSort } from "../lib/anilist";
import { getUserStatuses } from "../lib/list";
import type { UserStatus } from "../lib/list";
import { getCounts } from "../lib/counts";

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}

const url = Astro.url;

const paramsSchema = z.object({
  orden: z.enum(["puntuacion", "alfabetico"]).catch("puntuacion"),
  pagina: z.coerce.number().int().min(1).catch(1),
});

const params = paramsSchema.parse({
  orden: url.searchParams.get("orden") ?? undefined,
  pagina: url.searchParams.get("pagina") ?? undefined,
});

const sort: CatalogSort = params.orden;

const [catalog, counts] = await Promise.all([getCatalogPage({ sort, page: params.pagina }), getCounts(user.id)]);

const statusMap = catalog.error
  ? new Map<number, UserStatus>()
  : await getUserStatuses(user.id, catalog.items.map((anime) => anime.id));

const GRID_ID = "catalogo-grid";

function gridUrl(page: number): string {
  return `?orden=${sort}&pagina=${page}#${GRID_ID}`;
}

function orderUrl(value: CatalogSort): string {
  return `?orden=${value}&pagina=1#${GRID_ID}`;
}

const currentPage = catalog.currentPage;
const lastPage = catalog.lastPage;
const retryUrl = `?orden=${sort}&pagina=${currentPage}#${GRID_ID}`;

function resolveTitle(anime: (typeof catalog.items)[number]): string {
  return anime.title?.romaji || anime.title?.english || `Anime #${anime.id}`;
}

function buildPageList(current: number, last: number): (number | "ellipsis")[] {
  const pages = new Set<number>([1, last, current]);
  for (let i = current - 1; i <= current + 1; i += 1) {
    if (i >= 1 && i <= last) pages.add(i);
  }
  const sorted = Array.from(pages).sort((a, b) => a - b);
  const result: (number | "ellipsis")[] = [];
  let previous = 0;
  for (const page of sorted) {
    if (previous && page - previous > 1) result.push("ellipsis");
    result.push(page);
    previous = page;
  }
  return result;
}

const pageList = catalog.error ? [] : buildPageList(currentPage, lastPage);

const orderOptions: { value: CatalogSort; label: string }[] = [
  { value: "puntuacion", label: "Mejor puntuados" },
  { value: "alfabetico", label: "A–Z" },
];

const GRID_CLASS = "grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6";
---

<Layout title="Catálogo" activeNav="catalogo" counts={counts}>
  <div class="space-y-6 pb-24">
    <div class="flex flex-col gap-4 border-b border-white/5 pb-5">
      <div>
        <h1 class="text-xl font-bold tracking-tight text-text sm:text-2xl">Catálogo</h1>
        <p class="mt-1 text-sm text-text-muted">Descubrí animes de todo AniList y sumalos a tu lista.</p>
      </div>

      <div class="-mx-4 flex items-center gap-2 overflow-x-auto px-4 no-scrollbar sm:mx-0 sm:px-0">
        <span class="mr-1 shrink-0 text-xs text-text-muted">Ordenar por:</span>
        {orderOptions.map((option) => {
          const isActive = sort === option.value;
          return (
            <a
              href={orderUrl(option.value)}
              data-catalog-nav
              aria-current={isActive ? "true" : undefined}
              class:list={[
                "inline-flex min-h-[40px] shrink-0 items-center whitespace-nowrap rounded-full border px-3.5 text-xs font-medium backdrop-blur-md transition-all",
                isActive
                  ? "border-violet bg-surface-2/80 text-text shadow-sm shadow-violet/20"
                  : "border-white/5 bg-surface/60 text-text-muted hover:bg-surface-2/40 hover:text-text",
              ]}
            >
              {option.label}
            </a>
          );
        })}
      </div>
    </div>

    <div id={GRID_ID}>
      {catalog.error ? (
        <section class="mx-auto my-8 max-w-xl rounded-2xl border border-white/5 bg-surface p-8 text-center shadow-xl sm:p-12">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl border border-white/5 bg-surface-2 text-amber">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h2 class="text-lg font-semibold text-text">No pudimos cargar el catálogo</h2>
          <p class="mx-auto mt-2 max-w-sm text-sm text-text-muted">
            Hubo un problema al contactar con AniList. Probá de nuevo en unos segundos.
          </p>
          <a
            href={retryUrl}
            data-catalog-nav
            class="mt-6 inline-flex min-h-[44px] items-center justify-center rounded-xl bg-violet px-4 text-xs font-semibold text-white shadow-lg shadow-violet/25 transition hover:bg-violet/90"
          >
            Reintentar
          </a>
        </section>
      ) : catalog.items.length === 0 ? (
        <section class="mx-auto my-8 max-w-xl rounded-2xl border border-white/5 bg-surface p-8 text-center shadow-xl sm:p-12">
          <h2 class="text-lg font-semibold text-text">Sin resultados</h2>
          <p class="mx-auto mt-2 max-w-sm text-sm text-text-muted">
            No encontramos animes para mostrar en esta página.
          </p>
        </section>
      ) : (
        <div class={GRID_CLASS}>
          {catalog.items.map((anime) => (
            <CatalogCard
              id={anime.id}
              title={resolveTitle(anime)}
              coverImage={anime.coverImage?.large}
              color={anime.coverImage?.color}
              year={anime.seasonYear}
              format={anime.format}
              averageScore={anime.averageScore}
              status={statusMap.get(anime.id) ?? null}
            />
          ))}
        </div>
      )}
    </div>

    {!catalog.error && catalog.items.length > 0 && (
      <nav class="flex flex-col items-center gap-4 border-t border-white/5 pt-6" aria-label="Paginación del catálogo">
        <div class="flex w-full items-center justify-between gap-3 sm:hidden">
          {currentPage > 1 ? (
            <a
              href={gridUrl(currentPage - 1)}
              data-catalog-nav
              class="inline-flex min-h-[44px] items-center rounded-lg border border-white/5 bg-surface-2 px-3.5 text-xs font-medium text-text transition hover:border-violet"
            >
              &larr; Anterior
            </a>
          ) : (
            <span class="inline-flex min-h-[44px] cursor-not-allowed items-center rounded-lg border border-white/5 bg-surface-2/40 px-3.5 text-xs font-medium text-text-dim">
              &larr; Anterior
            </span>
          )}

          <span class="text-xs font-medium text-text-muted">Página {currentPage} de {lastPage}</span>

          {currentPage < lastPage ? (
            <a
              href={gridUrl(currentPage + 1)}
              data-catalog-nav
              class="inline-flex min-h-[44px] items-center rounded-lg border border-white/5 bg-surface-2 px-3.5 text-xs font-medium text-text transition hover:border-violet"
            >
              Siguiente &rarr;
            </a>
          ) : (
            <span class="inline-flex min-h-[44px] cursor-not-allowed items-center rounded-lg border border-white/5 bg-surface-2/40 px-3.5 text-xs font-medium text-text-dim">
              Siguiente &rarr;
            </span>
          )}
        </div>

        <div class="hidden flex-wrap items-center justify-center gap-2 sm:flex">
          {currentPage > 1 ? (
            <a
              href={gridUrl(currentPage - 1)}
              data-catalog-nav
              class="inline-flex min-h-[44px] items-center rounded-lg border border-white/5 bg-surface-2 px-3.5 text-xs font-medium text-text transition hover:border-violet"
            >
              &larr; Anterior
            </a>
          ) : (
            <span class="inline-flex min-h-[44px] cursor-not-allowed items-center rounded-lg border border-white/5 bg-surface-2/40 px-3.5 text-xs font-medium text-text-dim">
              &larr; Anterior
            </span>
          )}

          {pageList.map((entry) =>
            entry === "ellipsis" ? (
              <span class="px-1.5 text-xs text-text-dim" aria-hidden="true">
                …
              </span>
            ) : (
              <a
                href={gridUrl(entry)}
                data-catalog-nav
                aria-current={entry === currentPage ? "page" : undefined}
                class:list={[
                  "inline-flex h-11 min-w-[44px] items-center justify-center rounded-lg border px-2 text-xs font-semibold transition",
                  entry === currentPage
                    ? "border-violet bg-violet text-white shadow-lg shadow-violet/25"
                    : "border-white/5 bg-surface-2 text-text-muted hover:border-violet hover:text-text",
                ]}
              >
                {entry}
              </a>
            )
          )}

          {currentPage < lastPage ? (
            <a
              href={gridUrl(currentPage + 1)}
              data-catalog-nav
              class="inline-flex min-h-[44px] items-center rounded-lg border border-white/5 bg-surface-2 px-3.5 text-xs font-medium text-text transition hover:border-violet"
            >
              Siguiente &rarr;
            </a>
          ) : (
            <span class="inline-flex min-h-[44px] cursor-not-allowed items-center rounded-lg border border-white/5 bg-surface-2/40 px-3.5 text-xs font-medium text-text-dim">
              Siguiente &rarr;
            </span>
          )}
        </div>
      </nav>
    )}
  </div>

  <template id="catalog-skeleton-template">
    <div class={GRID_CLASS}>
      {Array.from({ length: 18 }).map(() => (
        <div class="animate-pulse">
          <div class="aspect-[2/3] w-full rounded-xl bg-surface-2"></div>
          <div class="mt-2 h-3 w-4/5 rounded bg-surface-2"></div>
          <div class="mt-1.5 h-3 w-1/2 rounded bg-surface-2"></div>
        </div>
      ))}
    </div>
  </template>

  <script is:inline>
    document.querySelectorAll("a[data-catalog-nav]").forEach((link) => {
      link.addEventListener("click", () => {
        const content = document.getElementById("catalogo-grid");
        const template = document.getElementById("catalog-skeleton-template");
        if (content && template) {
          content.replaceChildren(template.content.cloneNode(true));
        }
      });
    });
  </script>
</Layout>
