---
import Layout from "../layouts/Layout.astro";
import PendingOrderEditor from "../components/PendingOrderEditor";
import PageHeader from "../components/PageHeader.astro";
import { getPlanningOrder, getUserAnimeRow } from "../lib/list";
import { getCounts } from "../lib/counts";
import { getDictionary } from "../i18n";

export const prerender = false;

const dict = getDictionary(Astro.locals.locale);

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}

const [counts, pendingItems, planningOrder] = await Promise.all([
  getCounts(user.id),
  getUserAnimeRow(user.id, "PLANNING", 0, -1, "updatedAt"),
  getPlanningOrder(user.id),
]);
---

<Layout title={dict.lists.planningTitle} activeNav="inicio" counts={counts}>
  <div class="pb-8" data-anime-user={user.id} data-anime-return={Astro.url.pathname + Astro.url.search}>
    <PageHeader
      title={dict.lists.planningTitle}
      subtitle={dict.lists.planningSubtitle}
      count={counts.planning}
      countLabel={counts.planning === 1 ? dict.lists.countPendingOne : dict.lists.countPendingOther}
      countTone="violet"
    />

    <div class="mt-6">
      {pendingItems.length === 0 ? (
      <div class="mx-auto mt-8 max-w-xl rounded-2xl border border-white/5 bg-surface p-8 text-center sm:p-12">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl border border-white/5 bg-surface-2 text-violet">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-text">{dict.lists.emptyPlanningTitle}</h2>
        <p class="mx-auto mt-2 max-w-sm text-sm text-text-muted">
          {dict.lists.emptyPlanningDescription}
        </p>
        <p class="mt-6 text-xs text-text-dim">
          {dict.lists.emptyPlanningHint}
        </p>
      </div>
    ) : (
      <PendingOrderEditor client:load initialItems={pendingItems} initialOrder={planningOrder} locale={Astro.locals.locale} />
      )}
    </div>
  </div>
  <script>
    import { installAnimeListNavigation } from "../lib/anime-navigation";
    installAnimeListNavigation();
  </script>
</Layout>
